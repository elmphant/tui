{
    "name": "elmphant/tui",
    "description": "The Elm Architecture for terminal UIs (TUI) in PHP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "tui",
        "terminal",
        "cli",
        "console",
        "elm-architecture",
        "bubbletea",
        "ratatui"
    ],
    "authors": [
        {
            "name": "Wolfgang Klinger",
            "email": "wolfgang@wazum.com"
        }
    ],
    "homepage": "https://github.com/elmphant/tui",
    "support": {
        "issues": "https://github.com/elmphant/tui/issues",
        "source": "https://github.com/elmphant/tui"
    },
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "revolt/event-loop": "^1.0",
        "symfony/http-client-contracts": "^3.5",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.32.6",
        "league/commonmark": "^2.9",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-pcntl": "Without it a program runs but cannot see signals: no SIGWINCH resize detection, no graceful quit on SIGINT/SIGTERM, no Ctrl-Z suspend",
        "ext-posix": "Needed alongside ext-pcntl for Ctrl-Z suspend and resume",
        "amphp/http-client": "^5 for Cmd::fiber() work whose HTTP requests suspend the fiber instead of blocking (through Symfony's AmpHttpClient)",
        "league/commonmark": "^2.9 for Paragraph::fromMarkdown(); earlier 2.x releases carry denial-of-service advisories",
        "phpstan/phpstan": "Required to include rules.neon, which enforces the widget and model invariants in your own app",
        "symfony/http-client": "^6.4 || ^7.0 for Cmd::http(); the contracts this package requires are the interfaces alone, so an app that never makes a request installs no client"
    },
    "autoload": {
        "psr-4": {
            "Elmphant\\Tui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elmphant\\Tui\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "analyse": "./vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "check": [
            "@analyse",
            "@deptrac",
            "@test"
        ],
        "cs:check": "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer fix",
        "deptrac": "./vendor/bin/deptrac analyse --no-progress",
        "mutation": [
            "@mutation:coverage",
            "XDEBUG_MODE=off ./vendor/bin/infection --coverage=.infection/coverage --with-uncovered --only-covering-test-cases --threads=$(nproc)"
        ],
        "mutation:coverage": [
            "XDEBUG_MODE=coverage ./vendor/bin/phpunit --no-output --coverage-xml=.infection/coverage/coverage-xml",
            "XDEBUG_MODE=off ./vendor/bin/phpunit --no-output --log-junit=.infection/coverage/junit.xml"
        ],
        "mutation:diff": [
            "@mutation:coverage",
            "XDEBUG_MODE=off ./vendor/bin/infection --coverage=.infection/coverage --with-uncovered --only-covering-test-cases --threads=$(nproc) --git-diff-lines --git-diff-base=origin/main --logger-github"
        ],
        "mutation:dropdown": [
            "@mutation:coverage",
            "XDEBUG_MODE=off ./vendor/bin/infection --coverage=.infection/coverage --with-uncovered --only-covering-test-cases --threads=$(nproc) --min-msi=96 --filter=src/Widget/Popup/Dropdown.php,src/Widget/Popup/DropdownPopup.php,src/Runtime/InputRouter.php,src/Rendering/Context/RenderContext.php,src/Rendering/Context/FloatQueue.php,src/Rendering/Context/FloatPlacement.php"
        ],
        "qa": [
            "@analyse",
            "@deptrac",
            "@cs:check",
            "@test"
        ],
        "qa:fix": [
            "@cs:fix"
        ],
        "test": "./vendor/bin/phpunit",
        "test:e2e": "./vendor/bin/phpunit --testsuite e2e"
    }
}
