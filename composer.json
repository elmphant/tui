{
    "name": "elmphant/tui",
    "description": "The Elm Architecture for terminal UIs (TUI) in PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wolfgang Klinger",
            "email": "wolfgang@wazum.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "symfony/process": "^7.4",
        "symfony/http-client-contracts": "^3.5",
        "revolt/event-loop": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.32.6",
        "league/commonmark": "^2.9",
        "symfony/http-client": "^7.4",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "ergebnis/composer-normalize": "^2.52"
    },
    "suggest": {
        "ext-pcntl": "Without it a program runs but cannot see signals: no SIGWINCH resize detection, no graceful quit on SIGINT/SIGTERM, no Ctrl-Z suspend",
        "ext-posix": "Needed alongside ext-pcntl for Ctrl-Z suspend and resume",
        "league/commonmark": "^2.9 for Paragraph::fromMarkdown(); earlier 2.x releases carry denial-of-service advisories",
        "phpstan/phpstan": "Required to include rules.neon, which enforces the widget and model invariants in your own app",
        "symfony/http-client": "^7.4 for Cmd::http(); the contracts this package requires are the interfaces alone, so an app that never makes a request installs no client"
    },
    "autoload": {
        "psr-4": {
            "Elmphant\\Tui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elmphant\\Tui\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        }
    },
    "archive": {
        "exclude": [
            "/*",
            "!/src",
            "!/src/**",
            "!/composer.json",
            "!/rules.neon",
            "!/README.md",
            "!/LICENSE"
        ]
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ],
        "cs:check": "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer fix",
        "qa": [
            "@analyse",
            "@cs:check",
            "@test"
        ],
        "qa:fix": [
            "@cs:fix"
        ],
        "mutation": [
            "@mutation:coverage",
            "XDEBUG_MODE=off ./vendor/bin/infection --coverage=.infection/coverage --with-uncovered --only-covering-test-cases --threads=max"
        ],
        "mutation:coverage": [
            "XDEBUG_MODE=coverage ./vendor/bin/phpunit --no-output --coverage-xml=.infection/coverage/coverage-xml",
            "XDEBUG_MODE=off ./vendor/bin/phpunit --no-output --log-junit=.infection/coverage/junit.xml"
        ],
        "mutation:diff": [
            "@mutation:coverage",
            "XDEBUG_MODE=off ./vendor/bin/infection --coverage=.infection/coverage --with-uncovered --only-covering-test-cases --threads=max --git-diff-lines --git-diff-base=origin/main --logger-github"
        ],
        "mutation:dropdown": [
            "@mutation:coverage",
            "XDEBUG_MODE=off ./vendor/bin/infection --coverage=.infection/coverage --with-uncovered --only-covering-test-cases --threads=max --min-msi=96 --filter=src/Widget/Popup/Dropdown.php,src/Widget/Popup/DropdownPopup.php,src/Runtime/InputRouter.php,src/Rendering/RenderContext.php,src/Rendering/FloatPlacement.php"
        ]
    }
}
