parameters:
    elmphant:
        reachableChildrenAllowList: []
        cloneWithAllowList: []

parametersSchema:
    elmphant: structure([
        reachableChildrenAllowList: listOf(string()),
        cloneWithAllowList: listOf(string()),
    ])

services:
    -
        class: Elmphant\Tui\Stan\CompleteRebuildRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\NamedRebuildRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\WidgetDoesNotPublishAnAxisPolicyRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\ReachableChildrenRule
        arguments:
            allowList: %elmphant.reachableChildrenAllowList%
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\CloneWithEncapsulationRule
        arguments:
            allowList: %elmphant.cloneWithAllowList%
        tags:
            - phpstan.rules.rule
