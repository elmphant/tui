parameters:
    elmphant:
        reachableChildrenAllowList: []

parametersSchema:
    elmphant: structure([
        reachableChildrenAllowList: listOf(string()),
    ])

services:
    -
        class: Elmphant\Tui\Stan\BoundPropertiesAreRead
        arguments:
            parser: @defaultAnalysisParser
        tags:
            - phpstan.properties.readWriteExtension
    -
        class: Elmphant\Tui\Stan\CompleteRebuildRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\NamedRebuildRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\WidgetDoesNotPublishAnAxisPolicyRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\FocusIsAskedWhileDrawingRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\SplitIsBoundRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\KeyNameIsNotTextRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\ChildIsDrawnThroughTheContextRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Stan\ReachableChildrenRule
        arguments:
            allowList: %elmphant.reachableChildrenAllowList%
        tags:
            - phpstan.rules.rule
