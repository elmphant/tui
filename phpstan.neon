includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 9
    paths:
        - src
        - tests/Stan
    excludePaths:
        # Deliberate violations: they are the input to the rule's own tests.
        - tests/Stan/Fixtures
    tmpDir: var/phpstan
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        - identifier: return.unusedType
        # A keyed write-back names its constructor arguments at runtime, so no
        # analyser can match them against each consumer's signature, nor prove
        # that every subclass takes them.
        -
            identifier: argument.type
            path: src/Core/Cloneable.php
        -
            identifier: new.static
            path: src/Core/Cloneable.php

services:
    -
        class: Elmphant\Tui\Tests\Stan\CompleteRebuildRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Tests\Stan\NamedRebuildRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Tests\Stan\WidgetDoesNotPublishAnAxisPolicyRule
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Tests\Stan\ReachableChildrenRule
        arguments:
            # A container exposes what the caller handed it, not the parts it
            # built for itself. The filterables build their own field and list;
            # a Dropdown's content is drawn as a float and addressed through
            # RenderContext::floatPlacements(), never through the tree.
            allowList:
                - Elmphant\Tui\Widget\Dropdown
                - Elmphant\Tui\Widget\FilterableCheckboxGroup
                - Elmphant\Tui\Widget\FilterableList
                - Elmphant\Tui\Widget\FilterableTable
        tags:
            - phpstan.rules.rule
    -
        class: Elmphant\Tui\Tests\Stan\CloneWithEncapsulationRule
        arguments:
            allowList:
                - Elmphant\Tui\Core\App
        tags:
            - phpstan.rules.rule
