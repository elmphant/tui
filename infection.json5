{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": [
            "Testing",
            "Message",
            "Input/Terminal.php",
            "Rendering/Theme.php",
            "Runtime/MonotonicClock.php",
            "Runtime/ShutdownRestorer.php"
        ]
    },
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true,
        // Widens protected to public. No test can observe a visibility
        // relaxation, so every one of these survives: 11 of App.php's 14
        // escapes were the App hooks alone.
        "ProtectedVisibility": false
    },
    // Measured over the whole of src on 2026-09-02, ProtectedVisibility off:
    // 86.1% MSI / 88.6% covered (12609 mutants, 371 timeouts, which Infection
    // counts as detected).
    "minMsi": 86,
    "minCoveredMsi": 88,
    "testFramework": "phpunit",
    "tmpDir": ".infection"
}
