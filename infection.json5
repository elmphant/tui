{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": [
            "Testing",
            "Message",
            "Rendering/Theme.php",
            "Runtime/MonotonicClock.php",
            "Runtime/ShutdownRestorer.php"
        ]
    },
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true,
        // Widens protected to public. No test can observe a visibility
        // relaxation, so every one of these survives: 11 of App.php's 14
        // escapes were the App hooks alone.
        "ProtectedVisibility": false
    },
    // Measured over the whole of src on 2026-10-30, ProtectedVisibility off:
    // 90.5% MSI / 92.3% covered (15445 mutants, 311 timeouts, which Infection
    // counts as detected and which vary by about 80 between runs).
    "minMsi": 90,
    "minCoveredMsi": 92,
    "testFramework": "phpunit",
    "tmpDir": ".infection"
}
