{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": [
            "Testing",
            "Message",
            "Input/Terminal.php",
            "Rendering/Theme.php",
            "Runtime/MonotonicClock.php",
            "Runtime/ShutdownRestorer.php"
        ]
    },
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true
    },
    // Measured 87.74% MSI / 89% covered over the whole of src on 2026-08-16,
    // with StaticTable no longer excluded.
    "minMsi": 86,
    "minCoveredMsi": 93,
    "testFramework": "phpunit",
    "tmpDir": ".infection"
}
